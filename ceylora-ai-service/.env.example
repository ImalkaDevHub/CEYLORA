# CEYLORA AI Service — environment configuration
# Copy to .env and fill in your own values.

# Google AI Studio API key (free tier). Used by the planner agent to call
# Gemini. If unset or invalid, the planner falls back to a stub itinerary.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# CEYLORA .NET API — used by the destination agent to pull real destination
# data from the internal service-to-service endpoint. If unset or unreachable,
# the destination agent continues with an empty candidate list.
DOTNET_API_BASE_URL=http://localhost:5091
DOTNET_INTERNAL_API_KEY=

# Optional: port override for local dev (defaults to 8001 via the uvicorn command
# in the README). Not read by the app itself yet.
# PORT=8001
