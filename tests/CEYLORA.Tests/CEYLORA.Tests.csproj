<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <!-- A real relational engine, for transaction and constraint behaviour the in-memory provider cannot show. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Pin to the same EF version as InMemory; Npgsql in Infrastructure pulls an older Relational. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CEYLORA.Application\CEYLORA.Application.csproj" />
    <ProjectReference Include="..\..\src\CEYLORA.Domain\CEYLORA.Domain.csproj" />
    <ProjectReference Include="..\..\src\CEYLORA.Infrastructure\CEYLORA.Infrastructure.csproj" />
  </ItemGroup>

</Project>
